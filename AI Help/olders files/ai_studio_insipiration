import urllib.request
import subprocess

LOG_FILE = os.path.join(WORKSPACE, "comfyui_server.log")
COMFY_URL = "http://127.0.0.1:8188"

def is_server_alive():
    try:
        with urllib.request.urlopen(f"{COMFY_URL}/system_stats", timeout=2) as resp:
            return resp.status == 200
    except Exception:
        return False

if not is_server_alive():
    log_handle = open(LOG_FILE, "w")
    # Redirect stdout/stderr to a file on disk (NEVER subprocess.PIPE) so it cannot deadlock
