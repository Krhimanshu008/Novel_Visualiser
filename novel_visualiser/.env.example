# Novel Visualiser Configuration Template
# Copy this to .env and fill in your values

# === Project Settings ===
PROJECT_NAME=novel_visualiser
DATABASE_PATH=./novel_visualiser.db
MEDIA_ROOT=./output

# === LLM Configuration ===
# Google Gemini (Primary)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama (Fallback)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# === ComfyUI Configuration ===
# Remote Kaggle / Colab dual Tesla T4 Cloudflare tunnel:
COMFYUI_URL=https://your-cloudflare-tunnel.trycloudflare.com
COMFYUI_CLIENT_ID=novel_visualiser
COMFYUI_TIMEOUT_SECONDS=600

# === TTS & Audio Configuration ===
TTS_ENGINE=local_xtts
TTS_VOICE_DIR=./assets/voices
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
